---
// Root → the card feed. econ.kpan.dev is a feed of self-contained insight cards;
// this lists them in two sections (economy / markets), each with a live verdict,
// a sparkline of its recent history, and the reading's freshness.
import "../styles/globals.css";
import recessionData from "../data/recession.json";
import marketsData from "../data/markets.json";
import verdictsData from "../data/verdicts.json";
import { verdict as recessionVerdict } from "../lib/recession.mjs";
import { C, GAUGES, gaugeVerdict, fmt } from "../lib/gauges.mjs";
import type { RecessionData, MarketsData } from "../lib/types";

const recession = recessionData as RecessionData;
const markets = marketsData as MarketsData;
const verdicts = verdictsData as { cards?: Record<string, { since?: string; history?: unknown[] }> };

const nat = recession.regions.national;
const rv = recessionVerdict(nat.value, nat.prev);

const MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
function monthYear(iso: string) {
  const [y, m] = iso.split("-").map(Number);
  return `${MONTHS[m - 1]} ${y}`;
}

// A verdict is only "since" a date once a band change has actually been
// recorded — before that, the honest answer is silence.
function sinceLabel(id: string) {
  const card = verdicts.cards?.[id];
  return card?.history?.length && card.since ? `${monthYear(card.since)}` : null;
}

// Sparkline geometry: normalized polyline + endpoint dot for a value series.
function spark(values: number[], w = 84, h = 26, pad = 3) {
  const min = Math.min(...values);
  const max = Math.max(...values);
  const span = max - min || 1;
  const pts = values.map((v, i) => [
    pad + (i / Math.max(1, values.length - 1)) * (w - 2 * pad),
    pad + (1 - (v - min) / span) * (h - 2 * pad),
  ]);
  const d = pts.map(([x, y], i) => `${i ? "L" : "M"}${x.toFixed(1)} ${y.toFixed(1)}`).join(" ");
  const [cx, cy] = pts[pts.length - 1];
  return { d, cx: +cx.toFixed(1), cy: +cy.toFixed(1), w, h };
}

type Item = {
  href: string; eyebrow: string; headline: string; head: string; label: string;
  accent: string; value: string; asOf: string; since: string | null;
  sparkline: ReturnType<typeof spark>;
};

const recessionItem: Item = {
  href: "/recession",
  eyebrow: "Sahm Rule · Recession Nowcast",
  headline: "Are we in a recession?",
  head: rv.head,
  label: rv.label,
  accent: rv.accent,
  value: nat.value.toFixed(2),
  asOf: monthYear(nat.asOf),
  since: sinceLabel("recession"),
  sparkline: spark(nat.series.map((p) => p.sahm).filter((v): v is number => v != null).slice(-24)),
};

function gaugeItem(gaugeId: string): Item {
  const gauge = GAUGES[gaugeId];
  const r = markets.gauges[gaugeId];
  const v = gaugeVerdict(gauge, r.value, r.prev);
  return {
    href: `/${gauge.slug}`,
    eyebrow: gauge.eyebrow,
    headline: gauge.headline,
    head: v.head,
    label: v.label,
    accent: v.accent,
    value: fmt(gauge, r.value),
    asOf: monthYear(r.asOf),
    since: sinceLabel(gauge.id),
    sparkline: spark(r.series.map((p) => p.v)),
  };
}

const byGroup = (group: string) =>
  Object.values(GAUGES)
    .filter((gauge) => gauge.group === group && markets.gauges[gauge.id])
    .map((gauge) => gaugeItem(gauge.id));

const sections: { title: string; items: Item[] }[] = [
  { title: "The economy", items: [recessionItem, ...byGroup("economy")] },
  { title: "The markets", items: byGroup("markets") },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>econ.kpan.dev — economic insight cards</title>
    <meta name="description" content="A feed of self-contained economic insight cards: recession risk, inflation, wages, housing, market valuation, fear & greed. One derived metric each, built to be shared." />
    <link rel="canonical" href="https://econ.kpan.dev/" />
    <link rel="alternate" type="application/rss+xml" title="econ.kpan.dev — verdict changes" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="econ.kpan.dev" />
    <meta property="og:title" content="econ.kpan.dev — economic insight cards" />
    <meta property="og:description" content="Recession risk, inflation, wages, housing, market valuation, fear & greed — one derived metric per card, from real data." />
    <meta property="og:url" content="https://econ.kpan.dev/" />
    <meta property="og:image" content="https://econ.kpan.dev/og/recession-national.png" />
    <meta name="theme-color" content="#081113" />
  </head>
  <body style={`background:${C.backdrop}; color:${C.text}; font-family:Inter, system-ui, sans-serif; margin:0;`}>
    <main style="max-width:520px; margin:0 auto; padding:48px 20px 16px;">
      <h1 style={`font-family:'Bricolage Grotesque', sans-serif; font-weight:700; font-size:30px; letter-spacing:-.01em; margin:0 0 6px; color:${C.text};`}>
        econ.kpan.dev
      </h1>
      <p style={`font-size:14px; line-height:1.5; color:${C.muted}; margin:0 0 28px;`}>
        A feed of economic insight cards. Each one takes a single derived metric from real
        data and answers a question you actually care about — in one honest read.
      </p>

      {sections.map((section) => (
        <section style="margin-bottom:26px;">
          <h2 style={`font-family:'JetBrains Mono', monospace; font-size:11px; font-weight:500; letter-spacing:.16em; text-transform:uppercase; color:${C.faint}; margin:0 0 12px;`}>
            {section.title}
          </h2>
          {section.items.map((item) => (
            <a
              href={item.href}
              style={`display:block; text-decoration:none; background:${C.panel}; border:1px solid ${C.line}; border-radius:16px; padding:18px 20px; margin-bottom:14px;`}
            >
              <div style="display:flex; justify-content:space-between; align-items:center; gap:10px;">
                <span style={`font-family:'JetBrains Mono', monospace; font-size:10.5px; letter-spacing:.12em; text-transform:uppercase; color:${C.faint};`}>
                  {item.eyebrow}
                </span>
                <span style={`display:inline-flex; align-items:center; gap:6px; font-size:11px; font-weight:600; color:${item.accent}; white-space:nowrap;`}>
                  <span style={`width:7px; height:7px; border-radius:99px; background:${item.accent};`}></span>
                  {item.label.toUpperCase()}
                </span>
              </div>
              <div style={`font-family:'Bricolage Grotesque', sans-serif; font-weight:700; font-size:20px; color:${C.text}; margin:12px 0 4px;`}>
                {item.headline}
              </div>
              <div style="display:flex; justify-content:space-between; align-items:center; gap:12px;">
                <span style={`font-size:14px; color:${item.accent}; flex:1; min-width:0;`}>{item.head}</span>
                <svg
                  width={item.sparkline.w}
                  height={item.sparkline.h}
                  viewBox={`0 0 ${item.sparkline.w} ${item.sparkline.h}`}
                  aria-hidden="true"
                  style="flex:none;"
                >
                  <path d={item.sparkline.d} fill="none" stroke={item.accent} stroke-width="2" stroke-linecap="round" stroke-linejoin="round" opacity="0.85" />
                  <circle cx={item.sparkline.cx} cy={item.sparkline.cy} r="2.5" fill={item.accent} />
                </svg>
                <span style={`font-family:'JetBrains Mono', monospace; font-weight:700; font-size:15px; color:${item.accent}; white-space:nowrap;`}>{item.value}</span>
              </div>
              <div style={`margin-top:10px; font-family:'JetBrains Mono', monospace; font-size:10px; letter-spacing:.05em; color:${C.faint};`}>
                as of {item.asOf}{item.since && ` · ${item.label.toLowerCase()} since ${item.since}`}
              </div>
            </a>
          ))}
        </section>
      ))}
    </main>
    <footer style={`text-align:center; padding:18px 20px 32px; font-family:'JetBrains Mono', monospace; font-size:11px; letter-spacing:.04em; color:${C.faint};`}>
      <a href="/rss.xml" style={`color:${C.muted}; text-decoration:none;`}>RSS</a>
      <span style="margin:0 8px;">·</span>
      <a href="https://kpan.dev" style={`color:${C.muted}; text-decoration:none;`}>by Kevin Pan ↗ kpan.dev</a>
    </footer>
  </body>
</html>
